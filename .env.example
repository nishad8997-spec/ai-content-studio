# ============================================================================
# AI Content Studio — Frontend Client Environment Configuration
# ============================================================================

# Supabase Client Configuration (Public URL & Anonymous Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Billing Integration (Public Publishable Key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# Default AI Provider (Configured in Supabase Edge Functions: openai | anthropic | gemini)
VITE_DEFAULT_AI_PROVIDER=openai

# NOTE ON AI PROVIDER SECRETS:
# AI provider API keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY) are NEVER
# placed in this frontend .env file. They are securely configured as Supabase Edge
# Function Secrets via: `supabase secrets set OPENAI_API_KEY=sk-...`
